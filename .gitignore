# ml/registry/*.joblib
# ml/data/processed/*.parquet
# ml/data/processed/*.csv

# ------------------------------- Node / Frontend ----------------------------
node_modules/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# --------------------------------- Logs --------------------------------------
*.log
logs/

# ------------------------------ Editors / OS ---------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ------------------------------ Runtime Temp --------------------------------
tmp/
temp/
*.tmp