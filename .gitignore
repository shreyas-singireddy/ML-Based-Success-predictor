# ---------------------------------- Secrets ----------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ------------------------------- Python / Backend ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.coverage
.python-version

# ------------------------------- Databases -----------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------- ML Artifacts -------------------------------
