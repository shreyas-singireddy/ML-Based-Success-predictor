{
  "preprocessor_version": "1.0.0",
  "scaling_method": "robust",
  "num_impute_strategy": "median",
  "cat_impute_strategy": "constant",
  "total_input_features": 19,
  "total_transformed_features": 32,
  "numerical_features": [
