  ],
  "transformed_feature_names": [
    "age",
    "semester",
    "attendance_percentage",
    "previous_cgpa",
    "mid_1",
    "mid_2",
    "internal_marks",
    "backlogs",
    "academic_average",
    "attendance_risk_score",
    "internal_average",
