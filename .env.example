# ==============================================================================
# Student Success Predictor — Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# Copy this file to .env for local development and replace placeholders.

# ------------------------------------------------------------------------------
# Application Environment & Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | testing | staging | production
DEBUG=true                             # Set to false in production
APP_NAME="Student Success Predictor"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Security & Cryptography
# ------------------------------------------------------------------------------
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=change-me-to-a-strong-random-hex-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30         # Short-lived access token
REFRESH_TOKEN_EXPIRE_DAYS=7            # Refresh token lifecycle
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=student_predictor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=                                              # e.g. postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB
DATABASE_URL_SYNC=                                        # e.g. postgresql://USER:PASSWORD@HOST:5432/DB
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# Machine Learning Registry & Inference
# ------------------------------------------------------------------------------
ACTIVE_MODEL_VERSION=1.0.0
MODEL_REGISTRY_PATH=ml/registry/models
DATASET_STORAGE_PATH=ml/data
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MODERATE_THRESHOLD=0.60

# ------------------------------------------------------------------------------
# Generative AI Service (Google Gemini / OpenAI Compatible)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini                     # gemini | openai | local
GEMINI_API_KEY=your-google-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL_NAME=gemini-1.5-flash
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.2                     # Low temperature for deterministic, grounded advice

# ------------------------------------------------------------------------------
# Logging & Auditing
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                        # json | text
ENABLE_AUDIT_LOGGING=true

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Student Success Predictor"
